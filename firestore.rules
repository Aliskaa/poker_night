rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FONCTIONS UTILITAIRES
    // ============================================
    
    // Vérifie que l'utilisateur est authentifié via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Récupère l'ID de l'utilisateur authentifié
    function userId() {
      return request.auth.uid;
    }
    
    // Vérifie que l'utilisateur est le propriétaire du document
    function isOwner(uid) {
      return isAuthenticated() && userId() == uid;
    }
    
    // ============================================
    // COLLECTION: USERS
    // ============================================
    match /users/{uid} {
      // Lecture: Tout utilisateur authentifié peut voir les profils
      allow read: if isAuthenticated();
      
      // Création: Un utilisateur ne peut créer que son propre profil
      allow create: if isOwner(uid);
      
      // Mise à jour: Un utilisateur ne peut modifier que son profil
      allow update: if isOwner(uid);
      
      // Suppression: Désactivée
      allow delete: if false;
    }
    
    // ============================================
    // COLLECTION: GROUPS
    // ============================================
    match /groups/{groupId} {
      // Lecture: Membres du groupe uniquement
      allow read: if isAuthenticated() && 
        (userId() in resource.data.members || userId() == resource.data.ownerId);
      
      // Création: Tout utilisateur authentifié peut créer un groupe
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == userId();
      
      // Mise à jour: Propriétaire ou membre
      allow update: if isAuthenticated() && 
        (userId() == resource.data.ownerId || userId() in resource.data.members);
      
      // Suppression: Propriétaire uniquement
      allow delete: if isAuthenticated() && userId() == resource.data.ownerId;
    }
    
    // ============================================
    // COLLECTION: GAMES
    // ============================================
    match /games/{gameId} {
      // Fonction helper pour vérifier si l'utilisateur est un joueur
      function isPlayerInGame() {
        return resource.data.players.hasAny([
          {'id': userId()}
        ]) || resource.data.hostId == userId();
      }
      
      // Lecture: Utilisateur authentifié (pour voir les parties actives)
      allow read: if isAuthenticated();
      
      // Création: Tout utilisateur authentifié
      allow create: if isAuthenticated() && 
        request.resource.data.hostId == userId();
      
      // Mise à jour: Hôte de la partie
      allow update: if isAuthenticated() && userId() == resource.data.hostId;
      
      // Suppression: Hôte uniquement
      allow delete: if isAuthenticated() && userId() == resource.data.hostId;
    }
    
    // ============================================
    // COLLECTION: USER-GAME-STATS (Phase 3)
    // ============================================
    match /user-game-stats/{uid} {
      // Lecture: Tout utilisateur authentifié peut voir les stats
      allow read: if isAuthenticated();
      
      // Écriture: Désactivée (seulement Cloud Functions)
      allow write: if false;
    }
    
    // ============================================
    // COLLECTION: GAME-HISTORY (Phase 3)
    // ============================================
    match /game-history/{gameId} {
      // Lecture: Tout utilisateur authentifié
      allow read: if isAuthenticated();
      
      // Écriture: Désactivée (seulement Cloud Functions)
      allow write: if false;
      
      // Subcollection players
      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
      
      // Subcollection metadata
      match /metadata/{metaId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}