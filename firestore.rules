rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FONCTIONS UTILITAIRES
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userId() {
      return request.auth.uid;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && userId() == uid;
    }

    // Membre d'un groupe (propriétaire ou dans members[])
    function isGroupMember(groupId) {
      return groupId != null
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && (
          userId() == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          || userId() in get(/databases/$(database)/documents/groups/$(groupId)).data.members
        );
    }

    // Données du doc games/{gameId} : hôte, participantIds, ou club
    function canReadGameDoc(d) {
      return d.hostId == userId()
        || ('participantIds' in d && userId() in d.participantIds)
        || (d.groupId != null && isGroupMember(d.groupId));
    }

    // Pour la subcollection players : même logique + doc joueur id = uid (anciennes données)
    function canAccessGameAsPlayer(gameId) {
      let d = get(/databases/$(database)/documents/games/$(gameId)).data;
      return canReadGameDoc(d)
        || exists(/databases/$(database)/documents/games/$(gameId)/players/$(userId()));
    }
    
    // ============================================
    // COLLECTION: USERS
    // ============================================
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }
    
    // ============================================
    // COLLECTION: GROUPS
    // ============================================
    match /groups/{groupId} {
      allow read: if isAuthenticated() && 
        (userId() in resource.data.members || userId() == resource.data.ownerId);
      
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == userId();
      
      allow update: if isAuthenticated() && 
        (userId() == resource.data.ownerId || userId() in resource.data.members);
      
      allow delete: if isAuthenticated() && userId() == resource.data.ownerId;
    }
    
    // ============================================
    // COLLECTION: GAMES
    // ============================================
    match /games/{gameId} {
      allow read: if isAuthenticated() && (
        canReadGameDoc(resource.data)
        || exists(/databases/$(database)/documents/games/$(gameId)/players/$(userId()))
      );
      
      allow create: if isAuthenticated() && 
        request.resource.data.hostId == userId()
        && 'participantIds' in request.resource.data
        && userId() in request.resource.data.participantIds;
      
      allow update: if isAuthenticated() && userId() == resource.data.hostId;
      
      allow delete: if isAuthenticated() && userId() == resource.data.hostId;
      
      match /players/{playerId} {
        allow read: if isAuthenticated() && canAccessGameAsPlayer(gameId);
        
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/games/$(gameId)).data.hostId == userId() ||
          request.resource.data.userId == userId()
        );
        
        allow update: if isAuthenticated() && 
          get(/databases/$(database)/documents/games/$(gameId)).data.hostId == userId();
        
        allow delete: if isAuthenticated() && 
          get(/databases/$(database)/documents/games/$(gameId)).data.hostId == userId();
      }
    }
    
    // ============================================
    // COLLECTION: USER-GAME-STATS (Phase 3)
    // ============================================
    match /user-game-stats/{uid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ============================================
    // COLLECTION: GAME-HISTORY (Phase 3)
    // ============================================
    match /game-history/{gameId} {
      allow read: if isAuthenticated();
      allow write: if false;
      
      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
      
      match /metadata/{metaId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }
  }
}
